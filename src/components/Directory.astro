---
import { formatsAcross, datesAcross } from '../lib/catalog-controls.js';
import BookCover from './BookCover.astro';
import PublisherLogo from './PublisherLogo.astro';
import { seriesImageBook } from '../lib/series-image.js';
import SearchableList from './SearchableList.astro';
const { entries, section, label, placeholder, unit } = Astro.props;
---
<SearchableList label={label} placeholder={placeholder} count={entries.length} unit={unit} sortByCount directory formats={formatsAcross(entries.flatMap(entry => entry.books))}>
  <div class="directory-grid">
    {entries.map((entry) => (
      <a href={`/${section}/${entry.slug}/`} class:list={["dir-row directory-entry", {"directory-entry-illustrated": section === "series" || section === "publishers"}]} data-title-count={entry.books.length} data-oldest={datesAcross(entry.books).oldest} data-newest={datesAcross(entry.books).newest} data-formats={JSON.stringify(formatsAcross(entry.books))}
        data-search={[entry.name, ...(entry.roles || []), ...entry.books.map(book => [book.title, book.byline, book.publisher, book.series, book.isbn].join(' '))].join(' ')}>
        {section === "series" && <span class="series-directory-cover"><BookCover book={seriesImageBook(entry)} /></span>}
        {section === "publishers" && <PublisherLogo publisher={entry} />}
        <div class="directory-entry-info"><span class="directory-name">{entry.name}</span>{datesAcross(entry.books).oldest !== '' && <span class="directory-role">Published {datesAcross(entry.books).oldest}{datesAcross(entry.books).newest !== datesAcross(entry.books).oldest ? `–${datesAcross(entry.books).newest}` : ''}</span>}{entry.roles?.length > 0 && <span class="directory-role">{entry.roles.join(' · ')}</span>}</div>
        <span class="directory-titles">{entry.books.length} {entry.books.length === 1 ? 'title' : 'titles'} <span aria-hidden="true">↗</span></span>
      </a>
    ))}
  </div>
</SearchableList>
