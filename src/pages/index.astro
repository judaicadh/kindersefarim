---
import { coverFor } from '../lib/covers.js';
import BookCover from '../components/BookCover.astro';
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import { getBooks, buildFacets, FACET_DEFS, rowChips, buildSubjectTree, subjectPaths, fmtYear } from '../lib/sheet.js';

const { books, source } = await getBooks();
const featuredBooks = books.filter((book) => coverFor(book)).slice(0, 3);
const facets = buildFacets(books);
const subjectTree = buildSubjectTree(books);
// Hide any facet with no values (e.g. Place/Time period on a build that has
// none). The Subject facet uses the nested tree rather than flat opts.
const visibleFacets = facets.filter((f) => (f.id === 'f_topics' ? subjectTree.length : f.opts.length));

// Timeslider ranges. "Setting" spans the historical era a book is set in
// (startyear–endyear, BCE negative); "Published" spans copyright-date. Each
// slider renders only when the catalog actually carries those years.
const pubYears = books.map((b) => b.pubYear).filter((y) => y != null);
const setYears = books.flatMap((b) => [b.setStart, b.setEnd]).filter((y) => y != null);
const sliders = [];
if (setYears.length) {
  sliders.push({ id: 'set', name: 'Setting (historical)', min: Math.min(...setYears), max: Math.max(...setYears), bce: true });
}
if (pubYears.length) {
  sliders.push({ id: 'pub', name: 'Published', min: Math.min(...pubYears), max: Math.max(...pubYears), bce: false });
}
const nSetting = books.filter((b) => b.setStart != null).length;

// Banner shown only when we didn't build from the catalog data.
const bannerMeta = {
  local: null,
  sheet: null,
  sample: {
    label: 'Sample data',
    text: 'Showing example records. Set SHEET_ID to build from your Google Sheet.',
    bg: '#f2ead9', accent: '#8a5a12',
  },
  error: {
    label: "Couldn't reach the live sheet",
    text: 'Showing the last committed snapshot. Check that the sheet is still Published to the web as CSV (File → Share → Publish to web).',
    bg: '#f7e4d8', accent: '#a3421c',
  },
}[source];

// Per-row facet payload for client-side filtering (all values as arrays).
const facetKeys = FACET_DEFS.map((d) => d.id);
function facetPayload(b) {
  const o = {};
  for (const d of FACET_DEFS) {
    if (d.id === 'f_topics') {
      // Include every ancestor path so selecting a primary heading matches all
      // of its children (and selecting a child matches just that child).
      const set = new Set();
      for (const raw of b.f_topics || []) for (const p of subjectPaths(raw)) set.add(p);
      o[d.id] = [...set];
    } else {
      o[d.id] = d.arr ? (b[d.id] || []) : [b[d.id]];
    }
  }
  return o;
}
---

<Base entries={books}>
  <div style="min-height:100vh;background:#faf6ee">
    <Nav active="browse" />

    <!-- data-source banner -->
    {bannerMeta && (
      <div style={`padding:9px 44px;background:${bannerMeta.bg};border-bottom:1px solid rgba(23,35,58,.12);font:400 11.5px 'Source Sans 3',sans-serif;color:rgba(23,35,58,.7);display:flex;gap:8px;align-items:center`}>
        <span style={`font-weight:600;color:${bannerMeta.accent}`}>{bannerMeta.label}</span>
        <span>{bannerMeta.text}</span>
      </div>
    )}

    <section class="browse-hero" aria-labelledby="browse-title">
      <div class="hero-copy">
        <h1 id="browse-title">A bibliography of Orthodox <em>children's literature</em></h1>
        <div class="search-wrap">
          <svg viewBox="0 0 24 24" width="21" height="21" fill="none" aria-hidden="true"><circle cx="10" cy="10" r="6.5" stroke="currentColor" stroke-width="1.7"/><path d="m15 15 5 5" stroke="currentColor" stroke-width="1.7"/></svg>
          <label class="sr-only" for="q">Search the bibliography</label>
          <input id="q" type="search" placeholder="Find a title, author, illustrator, ISBN…" autocomplete="off" />
        </div>
      </div>
      <div class="hero-art" aria-hidden="true">
        <span class="art-spark spark-one">✳</span><span class="art-spark spark-two">✧</span>
        <span class="art-caption">So many stories to discover</span>
        <div class="illustrated-books">
          {featuredBooks.length === 3 ? featuredBooks.map((book, i) => (
            <div class:list={['art-book', 'featured-cover', ['book-a', 'book-b', 'book-c'][i]]}>
              <BookCover book={book} />
            </div>
          )) : (<>
          <div class="art-book book-a"><span>Once upon<br/>a Shabbos</span><svg viewBox="0 0 90 90" fill="none"><path d="M23 68V40h44v28M16 40l29-24 29 24M38 68V49h14v19" stroke="currentColor" stroke-width="3"/><path d="M6 75q39-8 78 0" stroke="currentColor" stroke-width="2"/></svg><small>STORIES & TRADITIONS</small></div>
          <div class="art-book book-b"><small>A WORLD OF</small><span>little<br/>wonders</span><svg viewBox="0 0 90 90" fill="none"><path d="M45 75V36M45 54Q15 58 18 32q26-1 27 22M45 64q29 2 28-26-25 0-28 26" stroke="currentColor" stroke-width="3"/><circle cx="45" cy="23" r="13" stroke="currentColor" stroke-width="2"/><path d="M45 5v6M45 35v6M27 23h6M57 23h6" stroke="currentColor" stroke-width="2"/></svg></div>
          <div class="art-book book-c"><span>Adventures<br/>await!</span><svg viewBox="0 0 90 90" fill="none"><path d="M12 70 39 26l15 25 8-13 19 32Z" stroke="currentColor" stroke-width="3"/><path d="m30 41 9 7 9-7M39 26V12h18l-5 6 5 6H39" stroke="currentColor" stroke-width="2"/></svg><small>TURN THE PAGE ↗</small></div>
          </>)}
        </div>
        <div class="art-shelf"></div><span class="art-spark spark-three">✦</span>
      </div>
    </section>
    <div class="catalog-heading"><div><p class="eyebrow">THE BIBLIOGRAPHY</p><h2>Find your next discovery<span>↘</span></h2></div><span class="catalog-stamp">{books.length} stories & counting</span></div>
    <div class="catalog-layout">
      <details class="filter-panel" open>
        <summary class="filter-toggle">Filters <span id="filterCount">0 active</span><span aria-hidden="true">⌄</span></summary>
        <aside class="facet-rail" aria-label="Filter books">
          <div class="filter-header"><h3>Refine your search</h3><button id="clearAll" type="button">Clear all</button></div>
          <p class="filter-help">Choose a few details to narrow the shelf.</p>
          {visibleFacets.map((f) => (
            <details class="filter-group" data-filter-group={f.id} data-name={f.name} open={f.id === 'f_type' || f.id === 'f_forms'}>
              <summary>{f.name}<span class="facet-selected" hidden></span><span class="filter-chevron" aria-hidden="true">⌄</span></summary>
              <div class="filter-group-content">
                {(f.id === 'f_topics' ? subjectTree.length > 8 : f.opts.length > 8) && (
                  <label class="facet-search"><span class="sr-only">{`Find ${f.name.toLowerCase()} options`}</span><input type="search" placeholder={`Find ${f.name.toLowerCase()}…`} data-facet-search autocomplete="off" /></label>
                )}
                <div class="facet-options">
                  {f.id === 'f_topics' ? subjectTree.map((p, i) => (
                    <div class="subject-option">
                      <div class="option-line">
                        <label class="opt" data-facet="f_topics" data-value={p.primary}>
                          <input type="checkbox" /><span class="lbl">{p.primary}</span><span class="option-count">{p.count}</span>
                        </label>
                        {p.children.length > 0 && <button type="button" class="caret" aria-expanded="false" aria-label={`Expand ${p.primary} subjects`} data-group={i}>▸</button>}
                      </div>
                      {p.children.length > 0 && <div class="subj-children" data-group={i} style="display:none">
                        {p.children.map((c) => <label class="opt" data-facet="f_topics" data-value={c.value}><input type="checkbox" /><span class="lbl">{c.label}</span><span class="option-count">{c.count}</span></label>)}
                      </div>}
                    </div>
                  )) : f.opts.map((o) => (
                    <label class="opt" data-facet={f.id} data-value={o.value}><input type="checkbox" /><span class="lbl">{o.value}</span><span class="option-count">{o.count}</span></label>
                  ))}
                </div>
                <p class="facet-no-options" hidden>No matching options.</p>
              </div>
            </details>
          ))}
          {sliders.map((s) => (
            <details class="filter-group year-group" data-name={s.name}>
              <summary>{s.name}<span class="filter-chevron" aria-hidden="true">⌄</span></summary>
              <div class="facet-slider filter-group-content" data-slider={s.id} data-name={s.name} data-min={s.min} data-max={s.max}>
                <div class="year-fields">
                  <label>From<input class="year-from" type="number" min={s.min} max={s.max} value={s.min} step="1" aria-label={`${s.name} from year`} /></label>
                  <span aria-hidden="true">–</span>
                  <label>To<input class="year-to" type="number" min={s.min} max={s.max} value={s.max} step="1" aria-label={`${s.name} to year`} /></label>
                </div>
                <div class="range-vals"><span class="range-lo">{fmtYear(s.min)}</span><span class="range-hi">{fmtYear(s.max)}</span></div>
                <div class="range-track"><div class="range-fill"></div><input class="range-min" type="range" min={s.min} max={s.max} value={s.min} step="1" aria-label={`${s.name} earliest year`} /><input class="range-max" type="range" min={s.min} max={s.max} value={s.max} step="1" aria-label={`${s.name} latest year`} /></div>
                <p class="year-help">{s.bce ? 'Use negative years for BCE. ' : ''}Undated books are included until you narrow this range.</p>
              </div>
            </details>
          ))}
          <button id="showResults" class="show-results" type="button">Show {books.length} books</button>
        </aside>
      </details>

      <!-- list -->
      <section class="catalog-results" aria-label="Books">
        <div id="activeFilters" class="active-filters" aria-label="Active filters" hidden></div>
        <div id="resultLabel" tabindex="-1" role="status" aria-live="polite" style="font:400 12px 'Source Sans 3',sans-serif;color:rgba(23,35,58,.5);margin-bottom:12px">{books.length} of {books.length} records</div>
        <div id="list" class="book-grid">
          {books.map((b) => (
            <a class="row" href={`/book/${b.id}/`}
              data-facets={JSON.stringify(facetPayload(b))}
              data-search={(b.title + ' ' + b.byline).toLowerCase()}
              data-pub={b.pubYear ?? ''}
              data-set-start={b.setStart ?? ''}
              data-set-end={b.setEnd ?? ''}
              >
              <BookCover book={b} />
              <div class="book-info">
                <div style="font:600 15.5px 'Lora',serif;color:#17233a">{b.title}</div>
                <div style="font:400 12px 'Source Sans 3',sans-serif;color:rgba(23,35,58,.6);margin-top:3px">{b.byline}</div>
              </div>
              <div class="book-chips">
                {rowChips(b).map((c) => (
                  <span style="font:500 10px 'Source Sans 3',sans-serif;color:#7a5a1e;background:#f2e6c4;padding:3px 8px;border-radius:2px;white-space:nowrap">{c}</span>
                ))}
              </div>
            </a>
          ))}
        </div>
        <div id="empty" style="display:none;padding:48px;text-align:center;font:400 13px 'Source Sans 3',sans-serif;color:rgba(23,35,58,.5)">No books match these filters. Try removing a filter or changing your search.</div>
      </section>
    </div>
  </div>

  <style is:global>
    .opt.sel .box { border-color: #17233a !important; background: #17233a !important; }
    .opt.sel .box::after { content: '✓'; }
    .opt.sel .lbl { color: #17233a !important; }
    .row:hover { background: rgba(199, 154, 58, 0.08); }

    /* dual-thumb range slider (two stacked native inputs + a shared track) */
    .range-track { position: relative; height: 26px; }
    .range-track .range-fill {
      position: absolute; top: 11px; height: 4px; border-radius: 2px;
      background: #8a5a12; z-index: 1; pointer-events: none;
    }
    .range-track::before {
      content: ''; position: absolute; left: 0; right: 0; top: 11px; height: 4px;
      border-radius: 2px; background: rgba(23,35,58,.18);
    }
    .range-track input[type='range'] {
      position: absolute; left: 0; width: 100%; top: 0; height: 26px; margin: 0;
      -webkit-appearance: none; appearance: none; background: none;
      pointer-events: none; z-index: 2;
    }
    .range-track input[type='range']::-webkit-slider-thumb {
      -webkit-appearance: none; appearance: none; pointer-events: auto;
      width: 15px; height: 15px; border-radius: 50%; background: #fffdf7;
      border: 2px solid #8a5a12; box-shadow: 0 1px 2px rgba(23,35,58,.3); cursor: pointer;
    }
    .range-track input[type='range']::-moz-range-thumb {
      pointer-events: auto; width: 15px; height: 15px; border-radius: 50%;
      background: #fffdf7; border: 2px solid #8a5a12; box-shadow: 0 1px 2px rgba(23,35,58,.3); cursor: pointer;
    }
    .range-track input[type='range']::-moz-range-track { background: none; }
    .facet-slider.active .range-vals { color: #8a5a12; }
  </style>

  <script define:vars={{ facetKeys }}>
    const sel = Object.fromEntries(facetKeys.map(k => [k, new Set()]));
    const num = value => value === '' || value == null ? null : Number(value);
    const rows = [...document.querySelectorAll('#list .row')].map(el => ({el, facets: JSON.parse(el.dataset.facets), search: el.dataset.search, pub:num(el.dataset.pub), setStart:num(el.dataset.setStart), setEnd:num(el.dataset.setEnd)}));
    const ranges = {};
    const sliderEls = [];
    const fmtYear = y => y < 0 ? -y + ' BCE' : String(y);
    const normalize = value => value.normalize('NFKD').replace(/[\u0300-\u036f]/g, '').toLowerCase();
    const q = document.getElementById('q');
    const label = document.getElementById('resultLabel');
    const empty = document.getElementById('empty');
    const panel = document.querySelector('.filter-panel');
    const options = [...document.querySelectorAll('.opt')];
    const groups = [...document.querySelectorAll('[data-filter-group]')];
    const activeFilters = document.getElementById('activeFilters');
    const total = rows.length;
    const mobile = window.matchMedia('(max-width:760px)');
    panel.open = !mobile.matches;
    mobile.addEventListener('change', event => { panel.open = !event.matches; });

    function matches(row, omitFacet) {
      if (q.value.trim() && !normalize(row.search).includes(normalize(q.value.trim()))) return false;
      for (const k of facetKeys) {
        if (k === omitFacet || !sel[k].size) continue;
        if (![...sel[k]].some(value => (row.facets[k] || []).includes(value))) return false;
      }
      const p = ranges.pub;
      if (p && (p.lo > p.min || p.hi < p.max) && (row.pub == null || row.pub < p.lo || row.pub > p.hi)) return false;
      const s = ranges.set;
      if (s && (s.lo > s.min || s.hi < s.max) && (row.setStart == null || row.setStart > s.hi || row.setEnd < s.lo)) return false;
      return true;
    }
    function chip(text, remove) {
      const button = document.createElement('button');
      button.type = 'button'; button.textContent = text + ' ×';
      button.setAttribute('aria-label', 'Remove filter: ' + text);
      button.addEventListener('click', () => { remove(); apply(); label.focus({preventScroll:true}); });
      activeFilters.append(button);
    }
    function apply() {
      let shown = 0;
      for (const row of rows) { const ok = matches(row); row.el.hidden = !ok; if (ok) shown++; }
      label.textContent = shown.toLocaleString() + ' of ' + total.toLocaleString() + ' books';
      empty.style.display = shown ? 'none' : 'block';
      document.getElementById('showResults').textContent = 'Show ' + shown.toLocaleString() + ' books';
      activeFilters.replaceChildren();
      for (const group of groups) {
        const facet = group.dataset.filterGroup;
        const badge = group.querySelector('.facet-selected');
        badge.textContent = sel[facet].size; badge.hidden = !sel[facet].size;
        const counts = new Map();
        for (const row of rows) if (matches(row, facet)) for (const value of row.facets[facet] || []) counts.set(value,(counts.get(value)||0)+1);
        group.querySelectorAll('.opt').forEach(opt => {
          const chosen = sel[facet].has(opt.dataset.value);
          const count = counts.get(opt.dataset.value) || 0;
          opt.querySelector('input').checked = chosen;
          opt.querySelector('input').disabled = !count && !chosen;
          opt.querySelector('.option-count').textContent = count.toLocaleString();
          opt.classList.toggle('sel',chosen);
        });
        for (const value of sel[facet]) chip(group.dataset.name + ': ' + value, () => sel[facet].delete(value));
      }
      for (const slider of sliderEls) if (slider.active()) chip(slider.name + ': ' + fmtYear(slider.lo.value) + '–' + fmtYear(slider.hi.value), () => slider.reset());
      const count = Object.values(sel).reduce((sum, set) => sum + set.size, 0) + sliderEls.filter(s => s.active()).length;
      activeFilters.hidden = !count;
      document.getElementById('filterCount').textContent = count ? count + ' active' : 'All books';
      document.getElementById('clearAll').disabled = !count && !q.value;
    }
    options.forEach(opt => opt.querySelector('input').addEventListener('change', event => {
      const set = sel[opt.dataset.facet];
      event.target.checked ? set.add(opt.dataset.value) : set.delete(opt.dataset.value);
      apply();
    }));
    function setGroup(caret, open) {
      const children = document.querySelector(`.subj-children[data-group="${caret.dataset.group}"]`);
      if (!children) return;
      children.style.display = open ? '' : 'none';
      caret.textContent = open ? '▾' : '▸'; caret.setAttribute('aria-expanded', String(open));
    }
    document.querySelectorAll('.caret').forEach(caret => caret.addEventListener('click', () => setGroup(caret, caret.getAttribute('aria-expanded') !== 'true')));
    function filterOptions(group) {
      const query = normalize(group.querySelector('[data-facet-search]')?.value.trim() || '');
      group.querySelectorAll('.opt').forEach(opt => { opt.hidden = !normalize(opt.dataset.value).includes(query); });
      group.querySelectorAll('.subject-option').forEach(wrapper => {
        const parent = wrapper.querySelector('.option-line .opt');
        const children = [...wrapper.querySelectorAll('.subj-children .opt')];
        const childMatch = children.some(child => !child.hidden);
        if (query && childMatch) { parent.hidden = false; const caret=wrapper.querySelector('.caret'); if (caret) setGroup(caret,true); }
        wrapper.hidden = parent.hidden && !childMatch;
      });
      group.querySelector('.facet-no-options').hidden = [...group.querySelectorAll('.opt')].some(opt => !opt.hidden);
    }
    groups.forEach(group => group.querySelector('[data-facet-search]')?.addEventListener('input', () => filterOptions(group)));
    document.querySelectorAll('.facet-slider').forEach(box => {
      const id=box.dataset.slider, min=Number(box.dataset.min), max=Number(box.dataset.max);
      const lo=box.querySelector('.range-min'),hi=box.querySelector('.range-max');
      const from=box.querySelector('.year-from'),to=box.querySelector('.year-to');
      ranges[id]={min,max,lo:min,hi:max};
      function refresh(changed=lo) {
        let a=Number(lo.value), b=Number(hi.value);
        if (a>b) { if(changed===lo) { b=a;hi.value=b; } else { a=b;lo.value=a; } }
        Object.assign(ranges[id],{lo:a,hi:b});from.value=a;to.value=b;
        const span=max-min||1; const fill=box.querySelector('.range-fill');
        fill.style.left=((a-min)/span)*100+'%'; fill.style.width=((b-a)/span)*100+'%';
        box.querySelector('.range-lo').textContent=fmtYear(a);box.querySelector('.range-hi').textContent=fmtYear(b);
        box.classList.toggle('active',a>min||b<max);
      }
      for(const input of [lo,hi]) input.addEventListener('input',()=>{refresh(input);apply();});
      for(const [field,range] of [[from,lo],[to,hi]]) {
        field.addEventListener('input',()=>{
          if(field.value===''||!field.validity.valid||!Number.isFinite(field.valueAsNumber))return;
          range.value=field.valueAsNumber;refresh(range);apply();
        });
        field.addEventListener('change',()=>{
          if(field.value===''||!Number.isFinite(field.valueAsNumber)){refresh(range);return;}
          range.value=Math.max(min,Math.min(max,Math.round(field.valueAsNumber)));refresh(range);apply();
        });
      }
      const slider={name:box.dataset.name,lo,hi,active:()=>Number(lo.value)>min||Number(hi.value)<max,reset:()=>{lo.value=min;hi.value=max;refresh();}};
      sliderEls.push(slider);refresh();
    });
    q.addEventListener('input',apply);
    document.getElementById('clearAll').addEventListener('click',()=>{
      facetKeys.forEach(k=>sel[k].clear());sliderEls.forEach(s=>s.reset());q.value='';
      groups.forEach(group=>{const input=group.querySelector('[data-facet-search]');if(input)input.value='';filterOptions(group);});apply();
    });
    document.getElementById('showResults').addEventListener('click',()=>{panel.open=false;label.focus();});
    const subject=new URLSearchParams(location.search).get('subject');
    if(subject) {
      const opt=options.find(opt=>opt.dataset.facet==='f_topics'&&opt.dataset.value===subject);
      if(opt) {
        sel.f_topics.add(subject);opt.closest('.filter-group').open=true;
        const children=opt.closest('.subj-children');
        if(children){const caret=document.querySelector(`.caret[data-group="${children.dataset.group}"]`);if(caret)setGroup(caret,true);}
      }
    }
    apply();
  </script>
</Base>
