---
import Directory from '../../components/Directory.astro';
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import { getBooks, buildPublishers } from '../../lib/sheet.js';

const { books } = await getBooks();
const publishers = buildPublishers(books);
---
<Base title="Publishers — Kinder Sefarim Bibliography">
  <div>
    <Nav active="publishers" />
    <header class="collection-heading">
      <p class="eyebrow">EXPLORE THE BIBLIOGRAPHY</p>
      <h1>Publishers</h1>
      <p>Search by name or find the publisher behind a book.</p>
    </header>
    <section class="collection-content" aria-label="Publishers">
      <Directory entries={publishers} section="publishers" label="Search publishers" placeholder="Search publishers or book titles…" unit="publishers" />
    </section>
  </div>
</Base>
