---
import Directory from '../../components/Directory.astro';
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import { getBooks, buildCreators } from '../../lib/sheet.js';

const { books } = await getBooks();
const creators = buildCreators(books);
---
<Base title="Authors & Contributors — Kinder Sefarim Bibliography">
  <div>
    <Nav active="authors" />
    <header class="collection-heading">
      <p class="eyebrow">EXPLORE THE BIBLIOGRAPHY</p>
      <h1>Authors &amp; Contributors</h1>
      <p>Search by name or find the people behind a book.</p>
    </header>
    <section class="collection-content" aria-label="Authors & Contributors">
      <Directory entries={creators} section="authors" label="Search authors" placeholder="Search authors, contributors, or book titles…" unit="people" />
    </section>
  </div>
</Base>
