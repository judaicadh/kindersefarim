---
import Directory from '../../components/Directory.astro';
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import { getBooks, buildSeries } from '../../lib/sheet.js';

const { books } = await getBooks();
const series = buildSeries(books);
---
<Base title="Series — Kinder Sefarim Bibliography" entries={series} collectionType="series">
  <div>
    <Nav active="series" />
    <header class="collection-heading">
      <p class="eyebrow">EXPLORE THE BIBLIOGRAPHY</p>
      <h1>Series</h1>
      <p>Search by name or find the series a book belongs to.</p>
    </header>
    <section class="collection-content" aria-label="Series">
      <Directory entries={series} section="series" label="Search series" placeholder="Search series or book titles…" unit="series" />
    </section>
  </div>
</Base>
