---
import '../styles/storybook.css';
import { linkedData, serializeLinkedData, PROJECT_CREATOR } from '../lib/linked-data.js';
const { title = 'Kinder Sefarim Bibliography', description = "A bibliography of Orthodox children's literature", book, entries, collection, collectionType } = Astro.props;
const origin = Astro.site?.href;
const metadata = linkedData({ path: Astro.url.pathname, origin, title, description, book, entries, collection, collectionType });
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={PROJECT_CREATOR.name} />
    {origin && <link rel="canonical" href={new URL(Astro.url.pathname, origin)} />}
    <script is:inline type="application/ld+json" set:html={serializeLinkedData(metadata)} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:wght@500;600;700;800&family=Lora:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&family=Source+Sans+3:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <link
      rel="stylesheet"
      id="silktide-consent-manager-css"
      href="https://cdn.jsdelivr.net/gh/silktide/consent-manager@v2.0.1/silktide-consent-manager.css"
      integrity="sha384-EdMq+R+YOnsbelo08wPenoTlnxbAyxI11NMIxzugx/qAsbh64KcOkqxYqq6pfvO/"
      crossorigin="anonymous"
    />
    <style is:global id="silktide-consent-manager-overrides">
      #stcm-wrapper {
        --boxShadow: -5px 5px 10px 0px #00000012, 0px 0px 50px 0px #0000001a !important;
        --fontFamily: 'Source Sans 3', 'Helvetica Neue', Segoe UI, Arial, sans-serif !important;
        --primaryColor: #17233a !important;
        --backgroundColor: #faf6ee !important;
        --textColor: #17233a !important;
        --backdropBackgroundColor: #17233a33 !important;
        --backdropBackgroundBlur: 0px !important;
        --iconColor: #8a5a12 !important;
        --iconBackgroundColor: #faf6ee !important;
      }
    </style>
    <script
      is:inline
      src="https://cdn.jsdelivr.net/gh/silktide/consent-manager@v2.0.1/silktide-consent-manager.js"
      integrity="sha384-5Pt34uiIbCsvfiiZXoLi4HRf/YBXjr9c8e+gYeVo9smUaInNHYVtc8NZ8wUnXJIq"
      crossorigin="anonymous"
    ></script>
    <script is:inline>
      window.silktideConsentManager.init({
        backdrop: {
          show: true
        },
        icon: {
          position: "bottomLeft"
        },
        prompt: {
          position: "bottomRight"
        },
        consentTypes: [
          {
            id: "essential",
            label: "Essential",
            description: "<p>These cookies are necessary for the website to function properly and cannot be switched off. They help with things like logging in and setting your privacy preferences.</p>",
            required: true,
            onAccept: function() {
              console.log("Add logic for the required Essential consent type here");
            }
          },
          {
            id: "analytics",
            label: "Analytics",
            description: "<p>These cookies help us improve the site by tracking which pages are most popular and how visitors move around the site.</p>",
            required: false,
            defaultValue: true,
            gtag: "analytics_storage"
          },
          {
            id: "marketing",
            label: "Marketing",
            description: "<p>These cookies are used by us and our advertising partners to show you relevant ads on this site and elsewhere, and to measure how those campaigns perform.</p>",
            required: false,
            gtag: [
              "ad_storage",
              "ad_user_data",
              "ad_personalization"
            ]
          }
        ],
        text: {
          prompt: {
            description: "<p>We use cookies on our site to enhance your user experience, provide personalized content, and analyze our traffic.</p>",
            acceptAllButtonText: "Accept all",
            acceptAllButtonAccessibleLabel: "Accept all cookies",
            rejectNonEssentialButtonText: "Reject non-essential",
            rejectNonEssentialButtonAccessibleLabel: "Reject all non-essential cookies",
            preferencesButtonText: "Preferences",
            preferencesButtonAccessibleLabel: "Toggle preferences"
          },
          preferences: {
            title: "Customize your cookie preferences",
            description: "<p>We respect your right to privacy. You can choose not to allow some types of cookies. Your cookie preferences will apply across our website.</p>",
            saveButtonText: "Save and close",
            saveButtonAccessibleLabel: "Save your cookie preferences",
            creditLinkText: "Get this banner for free",
            creditLinkAccessibleLabel: "Get this banner for free"
          }
        }
      });
    </script>
    <style is:global>
      body { margin: 0; background: #e9e5dd; font-family: 'Source Sans 3', sans-serif; }
      a { color: #8a5a12; text-decoration: none; }
      a:hover { color: #6b450d; }
      input { font-family: 'Source Sans 3', sans-serif; }
      ::placeholder { color: rgba(23, 35, 58, 0.4); }
      * { box-sizing: border-box; }
    </style>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <main id="main-content">
    <slot />
    </main>
    <footer class="site-footer">
      <div><a href="/" class="footer-brand">Kinder Sefarim</a><p class="project-credit">Bibliography created and curated by <a href={PROJECT_CREATOR.profile}>{PROJECT_CREATOR.name}</a></p></div>
      <a href="/about/">About the bibliography ↗</a>
      <div class="site-creation-credit">
        <p>Site created by</p>
        <img src="/branding/penn-libraries-judaica-digital-humanities.png" alt="Penn Libraries, University of Pennsylvania — Judaica Digital Humanities" width="2048" height="569" loading="lazy" />
      </div>
    </footer>
  </body>
</html>
